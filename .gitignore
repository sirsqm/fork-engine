# Build output. Never commit generated binaries, fetched dependencies, or
# caches; a clean checkout must build from source with one command.
build/
build-*/
cmake-build-*/
out/
# Release archives written by packaging/package_release.cmake. They are build
# output, not source: a release is produced from a tag, never committed.
/dist/
# An installed tree written into the checkout (cmake --install with a prefix
# under the source root). Anchored, so it does not swallow a source directory
# named "install" such as tests/install/.
/install/

# CMake
CMakeCache.txt
CMakeFiles/
CMakeUserPresets.json
cmake_install.cmake
CTestTestfile.cmake
_deps/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*.user
compile_commands.json
.cache/

# Engine import cache (derived data; see docs/adr/0029-import-cache.md). It is
# disposable by construction, so it never belongs in version control.
.fork/

# Compiled objects and libraries
*.o
*.obj
*.a
*.lib
*.so
*.so.*
*.dylib
*.dll
*.exe
*.pdb

# ...but a Wavefront mesh is a source asset, not a compiler object. Keep the
# example projects' meshes trackable; a game's own meshes live wherever the
# project puts them and are added with `git add -f` if they land elsewhere.
!examples/demo3d_project/assets/meshes/*.obj
!examples/game3d_project/assets/meshes/*.obj

# OS cruft
.DS_Store
Thumbs.db

# Local scratch
*.log
/tmp/

# Test scratch: the editor tests write editor_test_*.json into the working
# directory (see tests/src/test_editor_context.cpp). Test output, never source.
editor_test_*.json
