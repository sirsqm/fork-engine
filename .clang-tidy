# Fork Engine static analysis configuration.
#
# The checks below are intentionally conservative: they catch real bugs
# (lifetime, ownership, undefined behaviour) without demanding stylistic
# rewrites that fight the engine's conventions. Run with:
#
#   clang-tidy -p build <file>
#
# Enable more checks incrementally, one class at a time, rather than in bulk.
---
Checks: >
  bugprone-*,
  clang-analyzer-*,
  cppcoreguidelines-owning-memory,
  cppcoreguidelines-special-member-functions,
  modernize-use-nullptr,
  modernize-use-override,
  performance-*,
  readability-braces-around-statements,
  -bugprone-easily-swappable-parameters,
  -performance-no-int-to-ptr

WarningsAsErrors: ''
HeaderFilterRegex: 'engine/include/.*'

CheckOptions:
  - key: readability-braces-around-statements.ShortStatementLines
    value: 0
