# Turns the editor's font files into a C++ translation unit, run in CMake script
# mode at configure time.
#
#   cmake -DINPUT_DIR=<dir> -DOUTPUT=<file> -P cmake/EmbedFonts.cmake
#
# The editor ships a real typeface rather than Dear ImGui's built-in bitmap font,
# and the binary must find it from a build tree, an install tree, and an AppImage
# alike. Embedding the bytes removes the search: there is no font directory to
# locate relative to the executable, so all three layouts behave the same, and a
# user cannot break the editor by moving a file. The generated unit is written to
# the build tree, never committed; the fonts themselves are the committed asset.
#
# The header this satisfies (fe/editor/EditorFontData.h) is committed and names
# the symbols below; this script must keep emitting exactly those names. It runs
# at configure time rather than build time so no generator has to be on PATH when
# the editor is compiled.

if(NOT DEFINED INPUT_DIR)
  message(FATAL_ERROR "EmbedFonts.cmake: INPUT_DIR is required")
endif()
if(NOT DEFINED OUTPUT)
  message(FATAL_ERROR "EmbedFonts.cmake: OUTPUT is required")
endif()

# symbol -> source file, in the order the accessor table lists them. The symbol
# is the C identifier the generated array is defined under.
set(_fonts
  "kInterRegular:Inter-Regular.ttf"
  "kInterSemiBold:Inter-SemiBold.ttf"
  "kJetBrainsMono:JetBrainsMono-Regular.ttf"
)

set(_body "// Generated by cmake/EmbedFonts.cmake. Do not edit.\n")
string(APPEND _body "#include \"fe/editor/EditorFontData.h\"\n\n")
string(APPEND _body "namespace fe::editor::fonts {\n\n")

set(_entries "")
foreach(_pair IN LISTS _fonts)
  string(REPLACE ":" ";" _parts "${_pair}")
  list(GET _parts 0 _symbol)
  list(GET _parts 1 _file)
  set(_path "${INPUT_DIR}/${_file}")
  if(NOT EXISTS "${_path}")
    message(FATAL_ERROR "EmbedFonts.cmake: missing font '${_path}'")
  endif()

  # Read as a hex string and slice it into rows of 32 bytes. `file(READ ... HEX)`
  # is the one portable way to get bytes out of CMake without a helper program.
  file(READ "${_path}" _hex HEX)
  string(LENGTH "${_hex}" _hex_len)

  set(_rows "")
  set(_i 0)
  while(_i LESS _hex_len)
    string(SUBSTRING "${_hex}" ${_i} 64 _chunk)
    string(REGEX REPLACE "(..)" "0x\\1, " _chunk "${_chunk}")
    string(APPEND _rows "    ${_chunk}\n")
    math(EXPR _i "${_i} + 64")
  endwhile()

  string(APPEND _body "alignas(16) const unsigned char ${_symbol}Data[] = {\n${_rows}};\n")
  string(APPEND _body "const unsigned long ${_symbol}Size = sizeof(${_symbol}Data);\n\n")
  list(APPEND _entries "    {${_symbol}Data, ${_symbol}Size},")
endforeach()

string(APPEND _body "const EmbeddedFont kEmbeddedFonts[] = {\n")
foreach(_entry IN LISTS _entries)
  string(APPEND _body "${_entry}\n")
endforeach()
string(APPEND _body "};\n\n")
string(APPEND _body "const unsigned long kEmbeddedFontCount = sizeof(kEmbeddedFonts) / sizeof(kEmbeddedFonts[0]);\n\n")
string(APPEND _body "} // namespace fe::editor::fonts\n")

get_filename_component(_out_dir "${OUTPUT}" DIRECTORY)
file(MAKE_DIRECTORY "${_out_dir}")
file(WRITE "${OUTPUT}" "${_body}")
