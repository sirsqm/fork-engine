# ForkEngineConfig.cmake - the CMake package config for an installed Fork Engine.
#
# Generated by cmake/FEInstallDependencies.cmake. A consumer writes:
#
#   find_package(ForkEngine REQUIRED)
#   target_link_libraries(my_game PRIVATE ForkEngine::engine)
#
# and gets the engine library, its public headers, and every dependency archive
# the final link needs. The config resolves everything relative to its own
# location, so the installed tree is relocatable: unpack it anywhere and
# find_package still works, with no environment variable to set.
#
# The dependencies are found by path, not by find_package: they are the exact
# archives the engine was built against, installed beside it, so asking the
# system for a possibly-different version would be wrong even where one exists.

if(TARGET ForkEngine::engine)
  return()
endif()

# The config lives at <prefix>/lib/cmake/ForkEngine, so the prefix is three
# directories up. Computed from the file's own location so a moved tree works.
get_filename_component(_fe_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)

set(_fe_include "${_fe_prefix}/@CMAKE_INSTALL_INCLUDEDIR@")
set(_fe_lib "${_fe_prefix}/@FE_INSTALL_LIBDIR@")

if(NOT EXISTS "${_fe_include}/fe/version/Version.h")
  set(ForkEngine_FOUND FALSE)
  set(ForkEngine_NOT_FOUND_MESSAGE
      "ForkEngine headers not found under ${_fe_include}; the installed tree looks incomplete.")
  return()
endif()

add_library(ForkEngine::engine STATIC IMPORTED)
set_target_properties(ForkEngine::engine PROPERTIES
  IMPORTED_LOCATION "${_fe_lib}/${CMAKE_STATIC_LIBRARY_PREFIX}fork_engine${CMAKE_STATIC_LIBRARY_SUFFIX}"
  INTERFACE_INCLUDE_DIRECTORIES "${_fe_include}"
)

# The dependency archives, in the order a linker wants them: the engine first,
# then what it references. Each is added only if it was installed, so a tree
# built without a dependency (a web build has no GLFW) still yields a usable
# target rather than a missing-file error.
set(_fe_deps "")

foreach(_name glad_gl_core_33 glfw3 miniaudio)
  set(_archive "${_fe_lib}/${CMAKE_STATIC_LIBRARY_PREFIX}${_name}${CMAKE_STATIC_LIBRARY_SUFFIX}")
  if(EXISTS "${_archive}")
    list(APPEND _fe_deps "${_archive}")
  endif()
endforeach()

# Platform libraries the dependencies themselves need. These follow from the
# engine's dependency choices (GLFW uses dlopen and threads, miniaudio uses the
# platform audio API), so they are named here rather than left to the consumer.
set(_fe_platform @_fe_platform_libs@)

set_property(TARGET ForkEngine::engine PROPERTY
  INTERFACE_LINK_LIBRARIES "${_fe_deps};${_fe_platform}")

# Threads is a platform library with a compiler flag attached on some toolchains,
# so it is found rather than named.
find_package(Threads QUIET)
if(TARGET Threads::Threads)
  set_property(TARGET ForkEngine::engine APPEND PROPERTY
    INTERFACE_LINK_LIBRARIES Threads::Threads)
endif()

set(ForkEngine_FOUND TRUE)
set(ForkEngine_VERSION "@PROJECT_VERSION@")
set(ForkEngine_INCLUDE_DIRS "${_fe_include}")
set(ForkEngine_LIBRARIES ForkEngine::engine)

unset(_fe_prefix)
unset(_fe_include)
unset(_fe_lib)
unset(_fe_deps)
unset(_fe_platform)
unset(_name)
unset(_archive)
